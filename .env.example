# --- core ---
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DATABASE_URL=postgres://dayone:dayone@localhost:5432/dayone
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_BUCKET=dayone-dev
TOKEN_SIGNING_SECRET=change-me

# --- providers (ids from packages/ports) ---
SANDBOX_PROVIDER=local            # local | e2b
EDITOR_PROVIDER=openvscode
AGENT_PROVIDERS=claude-code,codex # enabled agents; a link may narrow this list
SCM_PROVIDER=github

# --- E2B ---
E2B_API_KEY=
E2B_DEFAULT_TEMPLATE=dayone-base

# --- agent gateway: vendor keys never leave the control plane ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_GATEWAY_BASE_URL=http://localhost:4000/gateway

# --- scm ---
GITHUB_TOKEN=
